# ---------------------------------------------------------------------------
# VESTA — modello delle variabili d'ambiente.
#
# Copia questo file in `.env.local` e riempilo. `.env.local` non finisce mai
# su git e non va messo sulla chiavetta: contiene chiavi che valgono come
# password.
#
# Regola: solo le variabili che iniziano per NEXT_PUBLIC_ arrivano al browser.
# Tutte le altre restano sul server. Se aggiungi una chiave, non chiamarla mai
# NEXT_PUBLIC_qualcosa, o finisce nel bundle che chiunque può leggere.
# ---------------------------------------------------------------------------

# --- Sito ------------------------------------------------------------------
# In locale lascia così. In produzione mettici il dominio vero, senza la barra
# finale: serve ai link delle email di accesso e alle anteprime social.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Supabase --------------------------------------------------------------
# Crea il progetto su https://supabase.com con regione Europe (Frankfurt).
# Le trovi in Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chiave pubblica (nella dashboard può chiamarsi "anon" oppure "publishable").
# Può stare nel browser: da sola non scavalca le regole di sicurezza.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave di amministrazione ("service_role" oppure "secret").
# ATTENZIONE: scavalca la Row Level Security e legge i dati di chiunque.
# Sta solo sul server, non va condivisa in chat e non va su una chiavetta.
SUPABASE_SERVICE_ROLE_KEY=


# --- Modelli AI ------------------------------------------------------------
# Quale fornitore usare. Cambiare queste righe basta a sostituire il modello:
# non serve toccare il codice.
AI_TEXT_PROVIDER=gemini
AI_TEXT_MODEL=gemini-2.5-flash

# Per le immagini: gemini | seedream | qwen
AI_IMAGE_PROVIDER=gemini
AI_IMAGE_MODEL=gemini-2.5-flash-image

# Chiave Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Servono solo se cambi AI_IMAGE_PROVIDER.
SEEDREAM_API_KEY=
QWEN_API_KEY=


# --- Tetto ai costi --------------------------------------------------------
# Immagini generate al giorno per utente. La stessa combinazione di capi e
# occasione non si rigenera comunque: viene ripresa dalla cache.
AI_IMAGE_DAILY_LIMIT=5

# Lato del quadrato in pixel. Più basso costa meno ed è comunque abbondante
# per uno schermo di telefono.
AI_IMAGE_SIZE=768


# --- Amministrazione -------------------------------------------------------
# Chi può aprire /admin. Più email separate da virgola.
ADMIN_EMAILS=hello.vesta.team@gmail.com


# --- Codici d'invito -------------------------------------------------------
# Finché VESTA non è pubblica, tengono fuori chi passa per caso: senza un
# codice valido non si vede niente, landing compresa.
#
# Più codici separati da virgola. Darne uno diverso a ciascuno permette di
# capire chi è entrato e di revocare il singolo senza togliere l'accesso a
# tutti gli altri. Il confronto ignora maiuscole e minuscole.
#
# ATTENZIONE: se questa riga è vuota o assente, il cancello è APERTO. È voluto:
# un errore di configurazione deve lasciare il sito visitabile, non spegnerlo.
#
# Non è una misura di sicurezza: sono codici condivisi, chi ne ha uno può
# passarlo a chiunque. I dati veri restano protetti dall'accesso via email e
# dalle regole del database.
ACCESS_CODES=


# --- Portale (facoltativo) -------------------------------------------------
# VESTA può girare dentro il sito di qualcun altro, che davanti al cancello
# vuole il proprio nome. Se lasci vuote queste righe, il portale si presenta
# come VESTA e basta.
#
# Il logo può essere un percorso servito dal dominio che ospita l'app: quel
# file appartiene a quel sito e non deve stare dentro questo progetto.
NEXT_PUBLIC_PORTAL_NAME=
NEXT_PUBLIC_PORTAL_TAGLINE=
NEXT_PUBLIC_PORTAL_LOGO=

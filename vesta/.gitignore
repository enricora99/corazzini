# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: fuori tutto tranne il modello, che serve a chi clona il progetto
.env*
!.env.example

# pacchetti generati da `npm run pack:usb`
/vesta-*.zip

# certificati di next dev --experimental-https
/certificates

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pacchetto sorgente: lo rigenera `npm run prebuild` a ogni build
public/vesta-codice.zip

# fotografie di partenza dell'armadio demo: immagini di catalogo, servono
# solo a rigenerare le miniature di public/demo/ e la repo e` pubblica.
# Le miniature gia` lavorate invece sono versionate: senza, la demo si
# ritroverebbe i disegni al posto delle foto a ogni nuova macchina.
/foto-demo
